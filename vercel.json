{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "fetch/*.php": { "runtime": "vercel-php@0.9.0" },
    "fetch/api/*.php": { "runtime": "vercel-php@0.9.0" },
    "fetch/r/*.php": { "runtime": "vercel-php@0.9.0" },
    "fetch/admin/*.php": { "runtime": "vercel-php@0.9.0" },
    "fetch/rider/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "rewrites": [
    { "source": "/fetch", "destination": "/fetch/index.php" },
    { "source": "/app", "destination": "/fetch/index.php" }
  ]
}
