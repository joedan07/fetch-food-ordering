# Copy to .env (local) or set these as environment variables on the host.
# Leave everything unset to use the XAMPP defaults (127.0.0.1, root, no password).

DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=fetch_db
DB_USER=xxxxxxxx.root
DB_PASS=your-password
DB_SSL=1          # cloud MySQL requires TLS; keep 0 on XAMPP

DB_SESSIONS=1     # store sessions in MySQL (required on serverless hosts)
DEMO_MODE=1       # show the one-click demo logins on the sign-in page
INSTALL_KEY=      # set to a secret word; install.php then needs ?key=<that word>
